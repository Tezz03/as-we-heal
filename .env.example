# Postgres connection string (Neon, Vercel Postgres, etc.)
DATABASE_URL=

# Stripe — massage bookings and farm market checkout (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# From the webhook endpoint pointed at https://your-domain.com/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=

# Shopify — featured product on the home page (leave blank to hide the section)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# The product's handle: the last part of its URL, e.g. /products/lavender-oil -> lavender-oil
SHOPIFY_PRODUCT_HANDLE=
