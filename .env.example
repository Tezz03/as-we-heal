# Postgres connection string (Neon, Vercel Postgres, etc.)
DATABASE_URL=

# Stripe — massage bookings and farm market checkout (dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
# From the webhook endpoint pointed at https://your-domain.com/api/stripe/webhook
# (events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=

# Your site's public address (used in emails and for link previews)
SITE_URL=https://your-domain.com

# Brittany admin page (/brittany) — choose a long, private password
ADMIN_PASSWORD=

# Email through Resend (resend.com) — confirmations, notifications, and replies from Brittany
RESEND_API_KEY=
# Must use the domain you verified in Resend
EMAIL_FROM=As We Heal <hello@your-domain.com>
# Where new booking, order, and message alerts go (defaults to the EMAIL_FROM address)
NOTIFY_EMAIL=
